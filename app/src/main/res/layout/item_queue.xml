<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/queueSelectCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:visibility="gone" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/queueThumbIV"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ri_file_video_line"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/queueTitleTV"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/queueTranslateBT"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ri_translate_2"
                        app:tint="?attr/colorPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="翻譯字幕" />

                    <ImageButton
                        android:id="@+id/queueEditBT"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ri_edit_line"
                        app:tint="?attr/colorPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="在預覽中編輯" />
                </LinearLayout>

                <TextView
                    android:id="@+id/queueStatusTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.75"
                    android:textSize="13sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/queueProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/queueOutputTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.78"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueCancelBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="取消"
                android:text="取消"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                app:icon="@drawable/ri_close_line"
                app:iconTint="?attr/colorError"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueExportVideoBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="匯出影片"
                android:text="匯出影片"
                android:visibility="gone"
                app:icon="@drawable/ri_file_video_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueExportSubtitleBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="儲存字幕"
                android:text="匯出字幕"
                android:visibility="gone"
                app:icon="@drawable/ri_file_text_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueCreateShortsBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="建立 Shorts"
                android:text="建立 Shorts"
                android:visibility="gone"
                app:icon="@drawable/baseline_movie_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueTalkOnlyBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="建立連續說話片段"
                android:text="僅保留說話片段"
                android:visibility="gone"
                app:icon="@drawable/ri_git_merge_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueSilenceRemovedBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="使用 VAD 移除靜音"
                android:text="移除靜音"
                android:visibility="gone"
                app:icon="@drawable/ri_restart_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueShareBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="分享"
                android:text="分享"
                android:visibility="gone"
                app:icon="@drawable/ri_share_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queuePlayBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="播放"
                android:text="播放"
                android:visibility="gone"
                app:icon="@drawable/ri_play_circle_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueRetryBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="重試"
                android:text="重試"
                android:visibility="gone"
                app:icon="@drawable/ri_restart_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueRemoveBT"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="移除"
                android:text="刪除"
                app:icon="@drawable/ri_delete_bin_line"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
